{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FitZone - Backend",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/backend/server.js",
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/.env",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "FitZone - Flutter",
            "type": "dart",
            "request": "launch",
            "program": "${workspaceFolder}/frontend/fitzone_app/lib/main.dart"
        }
    ]
}